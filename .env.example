# Copia questo file in .env e compila i valori
# cp .env.example .env && nano .env

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# Sessioni (stringa casuale, es: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME

# Gemini AI (free tier)
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek (motore con visione — platform.deepseek.com)
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_SIDE_PX=1024
DEEPSEEK_THINKING=disabled   # 'enabled' fa ragionare il modello: ~19x i token in uscita
DEEPSEEK_MAX_TOKENS=2000

# Embedding: bge-m3 servito da Ollama sulla macchina host
OLLAMA_BASE_URL=http://172.24.24.91:11434
OLLAMA_EMBED_MODEL=bge-m3

# Ricerca semantica: soglia assoluta e taglio relativo al miglior risultato
SEARCH_SIMILARITY_FLOOR=0.40
SEARCH_RELATIVE_CUTOFF=0.90

# Gemini AI (paid tier — stessa libreria/modello, limiti più alti)
GEMINI_PAID_API_KEY=CHANGE_ME

# Groq (alternativa a Gemini, free tier generoso — console.groq.com)
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MAX_SIDE_PX=768   # ridotto per risparmiare token (free tier: 500k TPD)

# Estensioni da escludere dalla scansione (es. ".cr3,.nef")
EXCLUDED_EXTS=

# Path dati
APP_DATA_PATH=/mnt/nas/photo_ai_data
LOCAL_DB=/opt/photo_ai/data/photo_ai.db
PHOTOS_PATH=/mnt/nas
AUTHORIZED_EMAILS_PATH=/opt/photo_ai/data/authorized_emails.txt

# NAS (usato da fstab — non letto dall'app direttamente)
NAS_CIFS_USER=CHANGE_ME
NAS_CIFS_PASSWORD=CHANGE_ME

# Porta applicazione
# URL pubblico da cui si raggiunge l'app (dietro cloudflared o altro proxy).
# Vuoto in sviluppo. Deve combaciare con l'URI di callback registrato su Google.
PUBLIC_BASE_URL=

APP_PORT=8080

# Decodifiche di miniature simultanee. Il picco di memoria e circa questo
# numero per la foto piu grande della libreria (~82 MB per uno scan da 24 MP).
THUMBNAIL_MAX_CONCURRENT=4
